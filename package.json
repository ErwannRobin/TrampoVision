{
  "name": "trampovision",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "upload-assets": "node scripts/upload-assets.mjs",
    "remove-asset": "node scripts/remove-asset.mjs",
    "postinstall": "node scripts/fetch-assets.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/archivo": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "mp4-muxer": "^5.2.2",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
