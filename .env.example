# The review service (see worker/). Leave empty to keep the app local-only: nothing is then sent anywhere.
VITE_REVIEW_API_URL=
# Sent as a bearer token with every upload. It ships in the bundle, so it is not a secret: it only keeps strangers from writing by accident.
VITE_REVIEW_INGEST_TOKEN=
# Public folder that holds the pose models, the wasm runtimes and the sample videos (layout: scripts/upload-assets.mjs, filled by `npm run upload-assets`).
# Set: the build leaves those files out and the app reads them from there. Empty: they are served from this origin (`npm run fetch-assets`), and there is no sample.
VITE_ASSET_BASE_URL=
# Jev (TypeSafe), the Classification tab of the coach rail (advanced tools). Set to https://api.typesafe.ai/v1 to let the browser call Jev, only when
# a person presses the button; the CSP and the local-only guard then let that one origin through. Empty: the tab says Jev is not in this build.
# The key is typed by the person in the tab and kept in their browser: it is never part of the build.
VITE_JEV_API_URL=
# Jev, offline comparison: `make jev-eval`. Read by scripts/jev-eval.ts, never by the app (no VITE_ prefix, so it cannot reach the bundle).
TYPESAFE_API_KEY=
