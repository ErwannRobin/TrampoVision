# The review service (see worker/). Leave empty to keep the app local-only: nothing is then sent anywhere.
VITE_REVIEW_API_URL=
# Sent as a bearer token with every upload. It ships in the bundle, so it is not a secret: it only keeps strangers from writing by accident.
VITE_REVIEW_INGEST_TOKEN=
# Public folder URL that holds IMG_8368.mp4 and IMG_8368.MOV (for example a Vercel Blob store), without them in the build. Leave empty for no sample button.
VITE_SAMPLE_BASE_URL=
